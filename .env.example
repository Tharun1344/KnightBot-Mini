# Bot identity and owners (international phone format, comma-separated if needed)
BOT_NAME=THARUN-WA-BOT
OWNER_NAME=YOUR_NAME
OWNER_NUMBER=YOUR_NUMBER_WITH_COUNTRY_CODE

# Supabase (required for cloud persistence). Keep keys private.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVER_SIDE_SECRET_OR_SERVICE_ROLE_KEY

# WhatsApp accounts: comma-separated IDs. First ID keeps the existing ./session folder.
# Example: WHATSAPP_ACCOUNTS=main,shop,backup
WHATSAPP_ACCOUNTS=main

# Optional custom session import for the primary account only.
# SESSION_ID=KnightBot!YOUR_COMPRESSED_SESSION_DATA

# Editable links shown in .menu
BOT_WHATSAPP_LINK=https://wa.me/YOUR_NUMBER
BOT_GITHUB_LINK=https://github.com/YOUR_USERNAME
BOT_FACEBOOK_LINK=https://facebook.com/YOUR_PAGE

# Optional photo-only forwarding to the configured owner chat (no AI analysis).
# This copies incoming image messages to the owner's chat; enable only if appropriate.
PHOTO_ARCHIVE=false
PHOTO_ARCHIVE_MAX_BYTES=8388608

# yt-dlp fallback for YouTube audio/video downloads
YTDLP_BIN=yt-dlp
YTDLP_TIMEOUT_MS=180000
YTDLP_MAX_AUDIO_BYTES=52428800
YTDLP_MAX_VIDEO_BYTES=67108864

# Keep autonomous source-code editing disabled unless deliberately needed.
ALLOW_SELF_EVOLVE=false
